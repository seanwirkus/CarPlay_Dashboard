<component>
    <view extends="lv_obj" width="540" height="290"
          style_pad_all="0" style_border_width="0" style_bg_opa="0">

        <dir_pad letter="L" align="left_mid"  x="0" y="0"/>
        <dir_pad letter="R" align="right_mid" x="0" y="0"/>

        <lv_obj width="320" height="220" align="center" x="0" y="-10"
                style_pad_all="0" style_border_width="0"
                style_bg_color="0x0A0A0A" style_bg_opa="255"
                style_radius="12">
            <lv_label text="AUDI e-tron" align="center"
                      style_text_color="0x222222"/>

            <lv_obj width="80" height="6" align="top_left" x="40" y="60"
                    style_pad_all="0" style_border_width="0"
                    style_bg_color="0xFD0000" style_bg_opa="255"
                    style_radius="3"/>
            <lv_obj width="80" height="6" align="top_right" x="-40" y="60"
                    style_pad_all="0" style_border_width="0"
                    style_bg_color="0xFD0000" style_bg_opa="255"
                    style_radius="3"/>
        </lv_obj>

        <lv_obj width="50" height="50" align="bottom_left"  x="120" y="0">
            <style name="st_circle_lt"/>
            <lv_label text="L1" align="center"
                      style_text_color="0xFFFFFF"/>
        </lv_obj>
        <lv_obj width="50" height="50" align="bottom_right" x="-120" y="0">
            <style name="st_accent_btn"/>
            <lv_label text="L2" align="center"
                      style_text_color="0xFFFFFF"/>
        </lv_obj>
    </view>
</component>
