<component>
    <view extends="lv_obj" width="220" height="220"
          style_pad_all="0" style_border_width="0" style_bg_opa="0">

        <!-- outer ring -->
        <lv_arc width="220" height="220" align="center"
                bg_start_angle="135" bg_end_angle="45"
                rotation="0" value="100"
                style_arc_width="2"
                style_arc_color="0x2A2F38"/>

        <!-- amber arc -->
        <lv_arc width="200" height="200" align="center"
                bg_start_angle="135" bg_end_angle="45"
                rotation="0"
                min_value="20" max_value="180"
                bind_value="sp_speed"
                style_arc_width="14"
                style_arc_color="0x222933"/>

        <!-- inner dark disc -->
        <lv_obj width="150" height="150" align="center">
            <style name="st_circle_dk"/>
        </lv_obj>

        <lv_label align="center" y="-10"
                  bind_text="sp_speed"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_48"/>

        <lv_label text="km/h" align="center" y="32"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_14"/>
    </view>
</component>
