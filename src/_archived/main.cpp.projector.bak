#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <U8g2lib.h>

#include "DmxOutput.h"
#include "board_pins.h"
#include "projector_config.h"
#include "web_app.h"

using namespace projector;

namespace {

U8G2_SSD1306_72X40_ER_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE);
WebServer server(80);
DmxOutput dmx;

enum class RunMode : uint8_t {
    Manual,
    Scene,
    Autoplay,
};

enum class ProximityZone : uint8_t {
    NoData,
    Safe,
    Warn,
    Trip,
};

enum class StripColorTarget : uint8_t {
    Unknown,
    NoData,
    Safe,
    Warn,
    Trip,
    Off,
};

struct ControllerState {
    RunMode mode = RunMode::Scene;
    bool blackout = true;
    uint8_t selectedScene = 0;
    uint8_t manualSlots[kUiSlotCount] = {0};
    uint8_t liveSlots[kUiSlotCount] = {0};
    uint32_t sceneStartedAt = 0;
};

struct ProximityState {
    float samples[kProximityFilterSize] = {0.0f};
    size_t sampleWriteIndex = 0;
    size_t sampleCount = 0;
    float filteredDistanceCm = NAN;
    float lastMeasuredDistanceCm = NAN;
    ProximityZone zone = ProximityZone::NoData;
    uint32_t lastSampleAt = 0;
};

struct StripState {
    StripColorTarget currentTarget = StripColorTarget::Unknown;
    uint32_t lastCommandAt = 0;
};

ControllerState state;
ProximityState proximity;
StripState stripState;
bool dmxReady = false;

bool buttonReading = HIGH;
bool buttonHandled = false;
uint32_t buttonChangedAt = 0;

uint32_t lastDmxFrameAt = 0;
uint32_t lastDisplayAt = 0;

const char* modeLabel() {
    switch (state.mode) {
        case RunMode::Manual:
            return "MAN";
        case RunMode::Scene:
            return "SCN";
        case RunMode::Autoplay:
            return "AUTO";
        default:
            return "---";
    }
}

const char* proximityLabel() {
    switch (proximity.zone) {
        case ProximityZone::Safe:
            return "SAFE";
        case ProximityZone::Warn:
            return "WARN";
        case ProximityZone::Trip:
            return "TRIP";
        case ProximityZone::NoData:
        default:
            return "NO DATA";
    }
}

const char* stripTargetLabel() {
    switch (stripState.currentTarget) {
        case StripColorTarget::NoData:
            return "NO DATA";
        case StripColorTarget::Safe:
            return "SAFE";
        case StripColorTarget::Warn:
            return "WARN";
        case StripColorTarget::Trip:
            return "TRIP";
        case StripColorTarget::Off:
            return "OFF";
        case StripColorTarget::Unknown:
        default:
            return "UNKNOWN";
    }
}

float clampFloat(float value, float minValue, float maxValue) {
    if (value < minValue) {
        return minValue;
    }
    if (value > maxValue) {
        return maxValue;
    }
    return value;
}

float displayDistanceCm() {
    if (!isnan(proximity.lastMeasuredDistanceCm)) {
        return proximity.lastMeasuredDistanceCm;
    }
    return proximity.filteredDistanceCm;
}

int distanceToBarX(float distanceCm, int barX, int barWidth) {
    const float rangeCm = kProximityMaxValidCm - kProximityBarMinCm;
    const float proximityRatio =
        1.0f - ((distanceCm - kProximityBarMinCm) / rangeCm);
    const float clampedRatio = clampFloat(proximityRatio, 0.0f, 1.0f);
    return barX + 1 + static_cast<int>(lroundf(clampedRatio * (barWidth - 2)));
}

void resetProximitySamples() {
    memset(proximity.samples, 0, sizeof(proximity.samples));
    proximity.sampleWriteIndex = 0;
    proximity.sampleCount = 0;
    proximity.filteredDistanceCm = NAN;
    proximity.lastMeasuredDistanceCm = NAN;
    proximity.zone = ProximityZone::NoData;
    proximity.lastSampleAt = 0;
}

void setIrIdleLevel() {
    digitalWrite(IR_TX_PIN, kStripIrActiveLow ? HIGH : LOW);
}

void setIrMarkLevel() {
    digitalWrite(IR_TX_PIN, kStripIrActiveLow ? LOW : HIGH);
}

void irSpace(uint32_t microseconds) {
    setIrIdleLevel();
    delayMicroseconds(microseconds);
}

void irMark(uint32_t microseconds) {
    setIrMarkLevel();
    delayMicroseconds(microseconds);
}

void sendNecCode(uint32_t code) {
    if (code == 0) {
        return;
    }

    noInterrupts();
    irMark(9000);
    irSpace(4500);

    for (uint8_t i = 0; i < 32; ++i) {
        irMark(560);
        if (code & (1UL << i)) {
            irSpace(1690);
        } else {
            irSpace(560);
        }
    }

    irMark(560);
    setIrIdleLevel();
    interrupts();
}

uint32_t stripCodeForTarget(StripColorTarget target) {
    switch (target) {
        case StripColorTarget::NoData:
            return kStripNoDataColorCode;
        case StripColorTarget::Safe:
            return kStripSafeColorCode;
        case StripColorTarget::Warn:
            return kStripWarnColorCode;
        case StripColorTarget::Trip:
            return kStripTripColorCode;
        case StripColorTarget::Off:
            return kStripPowerOffCode;
        case StripColorTarget::Unknown:
        default:
            return 0;
    }
}

StripColorTarget desiredStripTarget() {
    if (!kStripControlEnabled) {
        return StripColorTarget::Unknown;
    }

    if (state.blackout) {
        return StripColorTarget::Off;
    }

    switch (proximity.zone) {
        case ProximityZone::Safe:
            return StripColorTarget::Safe;
        case ProximityZone::Warn:
            return StripColorTarget::Warn;
        case ProximityZone::Trip:
            return StripColorTarget::Trip;
        case ProximityZone::NoData:
        default:
            return StripColorTarget::NoData;
    }
}

void updateStripColor() {
    if (!kStripControlEnabled) {
        return;
    }

    const StripColorTarget target = desiredStripTarget();
    if (target == stripState.currentTarget) {
        return;
    }

    const uint32_t now = millis();
    if (now - stripState.lastCommandAt < kStripCommandGapMs) {
        return;
    }

    if (target != StripColorTarget::Off && kStripPowerOnCode != 0 &&
        stripState.currentTarget == StripColorTarget::Off) {
        sendNecCode(kStripPowerOnCode);
        delay(kStripCommandGapMs);
    }

    const uint32_t code = stripCodeForTarget(target);
    if (code != 0) {
        sendNecCode(code);
    } else if (target == StripColorTarget::Off && kStripPowerOffCode != 0) {
        sendNecCode(kStripPowerOffCode);
    } else {
        return;
    }

    stripState.currentTarget = target;
    stripState.lastCommandAt = millis();
}

void copySlots(uint8_t* dest, const uint8_t* src) {
    memcpy(dest, src, kUiSlotCount);
}

void setLiveScene(uint8_t index) {
    if (index >= kSceneCount) {
        return;
    }
    copySlots(state.liveSlots, kScenes[index].slots);
}

void setManualMode() {
    state.mode = RunMode::Manual;
    copySlots(state.liveSlots, state.manualSlots);
}

void setSceneMode(uint8_t index) {
    if (index >= kSceneCount) {
        return;
    }
    state.mode = RunMode::Scene;
    state.selectedScene = index;
    state.sceneStartedAt = millis();
    setLiveScene(index);
}

void setAutoplayMode() {
    state.mode = RunMode::Autoplay;
    state.sceneStartedAt = millis();
    setLiveScene(state.selectedScene);
}

void clearLiveSlots() {
    memset(state.liveSlots, 0, sizeof(state.liveSlots));
}

uint8_t blendChannel(uint8_t from, uint8_t to, float mix) {
    const float blended = from + (to - from) * mix;
    return static_cast<uint8_t>(constrain(lroundf(blended), 0L, 255L));
}

void pushProximitySample(float distanceCm) {
    proximity.samples[proximity.sampleWriteIndex] = distanceCm;
    proximity.sampleWriteIndex = (proximity.sampleWriteIndex + 1) % kProximityFilterSize;
    if (proximity.sampleCount < kProximityFilterSize) {
        ++proximity.sampleCount;
    }
}

float filteredProximityDistanceCm() {
    float values[kProximityFilterSize];
    size_t validCount = 0;

    for (size_t i = 0; i < proximity.sampleCount; ++i) {
        const float sample = proximity.samples[i];
        if (!isnan(sample)) {
            values[validCount++] = sample;
        }
    }

    if (validCount < kProximityMinSamples) {
        return NAN;
    }

    for (size_t i = 1; i < validCount; ++i) {
        const float key = values[i];
        size_t j = i;
        while (j > 0 && values[j - 1] > key) {
            values[j] = values[j - 1];
            --j;
        }
        values[j] = key;
    }

    return values[validCount / 2];
}

float measureProximityDistanceCm() {
    digitalWrite(US_TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(US_TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(US_TRIG_PIN, LOW);

    const unsigned long durationUs = pulseIn(US_ECHO_PIN, HIGH, kProximityEchoTimeoutUs);
    if (durationUs == 0) {
        return NAN;
    }

    const float distanceCm = (durationUs * 0.0343f) / 2.0f;
    if (distanceCm < kProximityMinValidCm || distanceCm > kProximityMaxValidCm) {
        return NAN;
    }

    return distanceCm;
}

void updateProximity() {
    const uint32_t now = millis();
    if (now - proximity.lastSampleAt < kProximitySampleIntervalMs) {
        return;
    }

    proximity.lastSampleAt = now;
    proximity.lastMeasuredDistanceCm = measureProximityDistanceCm();
    pushProximitySample(proximity.lastMeasuredDistanceCm);
    proximity.filteredDistanceCm = filteredProximityDistanceCm();

    if (isnan(proximity.filteredDistanceCm)) {
        proximity.zone = ProximityZone::NoData;
    } else if (proximity.filteredDistanceCm <= kProximityTripDistanceCm) {
        proximity.zone = ProximityZone::Trip;
    } else if (proximity.filteredDistanceCm <= kProximityWarnDistanceCm) {
        proximity.zone = ProximityZone::Warn;
    } else {
        proximity.zone = ProximityZone::Safe;
    }
}

void updateSceneEngine() {
    if (state.mode == RunMode::Manual) {
        copySlots(state.liveSlots, state.manualSlots);
        return;
    }

    if (state.mode == RunMode::Scene) {
        setLiveScene(state.selectedScene);
        return;
    }

    const uint32_t now = millis();
    const uint32_t cycleMs = kSceneHoldMs + kCrossfadeMs;
    const uint32_t elapsed = (now - state.sceneStartedAt) % cycleMs;

    if (now - state.sceneStartedAt >= cycleMs) {
        state.sceneStartedAt = now - elapsed;
        state.selectedScene = (state.selectedScene + 1) % kSceneCount;
    }

    const uint8_t current = state.selectedScene;
    const uint8_t next = (state.selectedScene + 1) % kSceneCount;

    if (elapsed < kSceneHoldMs) {
        setLiveScene(current);
        return;
    }

    const float mix = static_cast<float>(elapsed - kSceneHoldMs) / static_cast<float>(kCrossfadeMs);
    for (size_t i = 0; i < kUiSlotCount; ++i) {
        state.liveSlots[i] = blendChannel(kScenes[current].slots[i], kScenes[next].slots[i], mix);
    }
}

void applyDmxState() {
    dmx.clear();

    if (!state.blackout) {
        for (size_t i = 0; i < kUiSlotCount; ++i) {
            dmx.setSlot(kDmxStartAddress + i, state.liveSlots[i]);
        }
    }

    dmx.sendFrame();
}

void updateStatusLed() {
    digitalWrite(LED_PIN, state.blackout ? LOW : HIGH);
}

String buildStatusJson() {
    String json;
    json.reserve(512);
    json += "{\"mode\":\"";
    json += modeLabel();
    json += "\",\"blackout\":";
    json += state.blackout ? "true" : "false";
    json += ",\"selectedScene\":";
    json += state.selectedScene;
    json += ",\"startAddress\":";
    json += kDmxStartAddress;
    json += ",\"slots\":[";
    for (size_t i = 0; i < kUiSlotCount; ++i) {
        if (i) {
            json += ',';
        }
        json += state.liveSlots[i];
    }
    json += "],\"sceneNames\":[";
    for (size_t i = 0; i < kSceneCount; ++i) {
        if (i) {
            json += ',';
        }
        json += '"';
        json += kScenes[i].name;
        json += '"';
    }
    json += "],\"ssid\":\"";
    json += kAccessPointSsid;
    json += "\",\"ip\":\"";
    json += WiFi.softAPIP().toString();
    json += "\",\"dmxReady\":";
    json += dmxReady ? "true" : "false";
    json += ",\"transport\":\"DMX\"";
    json += ",\"proximityCm\":";
    if (isnan(proximity.filteredDistanceCm)) {
        json += "null";
    } else {
        json += String(proximity.filteredDistanceCm, 1);
    }
    json += ",\"proximityZone\":\"";
    json += proximityLabel();
    json += "\",\"proximityWarnCm\":";
    json += String(kProximityWarnDistanceCm, 0);
    json += ",\"proximityTripCm\":";
    json += String(kProximityTripDistanceCm, 0);
    json += ",\"stripTarget\":\"";
    json += stripTargetLabel();
    json += "\"";
    json += ",\"arbitraryDraw\":false";
    json += '}';
    return json;
}

void sendOk() {
    server.send(200, "application/json", buildStatusJson());
}

void handleRoot() {
    server.send_P(200, "text/html", kRootPage);
}

void handleStatus() {
    server.send(200, "application/json", buildStatusJson());
}

void handleManual() {
    for (size_t i = 0; i < kUiSlotCount; ++i) {
        const String argName = "ch" + String(i + 1);
        if (server.hasArg(argName)) {
            state.manualSlots[i] = static_cast<uint8_t>(constrain(server.arg(argName).toInt(), 0, 255));
        }
    }
    setManualMode();
    sendOk();
}

void handleScene() {
    if (server.hasArg("index")) {
        const int index = server.arg("index").toInt();
        if (index >= 0 && index < static_cast<int>(kSceneCount)) {
            setSceneMode(static_cast<uint8_t>(index));
        }
    }
    sendOk();
}

void handleMode() {
    if (server.hasArg("value")) {
        const String mode = server.arg("value");
        if (mode == "manual") {
            setManualMode();
        } else if (mode == "autoplay") {
            setAutoplayMode();
        }
    }
    sendOk();
}

void handleBlackout() {
    if (server.hasArg("enabled")) {
        state.blackout = server.arg("enabled").toInt() != 0;
    }
    sendOk();
}

void configureWebServer() {
    server.on("/", HTTP_GET, handleRoot);
    server.on("/api/status", HTTP_GET, handleStatus);
    server.on("/api/manual", HTTP_GET, handleManual);
    server.on("/api/scene", HTTP_GET, handleScene);
    server.on("/api/mode", HTTP_GET, handleMode);
    server.on("/api/blackout", HTTP_GET, handleBlackout);
    server.begin();
}

void drawDmxDisplay() {
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_5x8_tr);
    u8g2.drawStr(0, 8, "Laser Show DMX");

    u8g2.setFont(u8g2_font_6x10_tr);
    u8g2.drawStr(0, 20, modeLabel());
    u8g2.drawStr(28, 20, state.blackout ? "BLACKOUT" : "LIVE");

    const String ip = WiFi.softAPIP().toString();
    u8g2.drawStr(0, 31, ip.c_str());

    char line[24];
    snprintf(line, sizeof(line), "SCN %u ADR %u", state.selectedScene + 1, kDmxStartAddress);
    u8g2.drawStr(0, 40, line);
    u8g2.sendBuffer();
}

void drawProximityDisplay() {
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_5x8_tr);
    char topLine[24];
    snprintf(topLine, sizeof(topLine), "%s %s", modeLabel(), state.blackout ? "BLK" : "LIVE");
    u8g2.drawStr(0, 8, topLine);

    u8g2.setFont(u8g2_font_6x10_tr);
    const float liveDistance = displayDistanceCm();
    if (isnan(liveDistance)) {
        u8g2.drawStr(0, 20, "NO ECHO");
    } else {
        char distanceLine[22];
        snprintf(distanceLine, sizeof(distanceLine), "%5.1fcm", liveDistance);
        u8g2.drawStr(0, 20, distanceLine);
    }

    char zoneLine[24];
    snprintf(zoneLine, sizeof(zoneLine), "%s %s", proximityLabel(), stripTargetLabel());
    u8g2.drawStr(0, 31, zoneLine);

    constexpr int kBarX = 0;
    constexpr int kBarY = 32;
    constexpr int kBarW = 72;
    constexpr int kBarH = 8;
    u8g2.drawFrame(kBarX, kBarY, kBarW, kBarH);

    if (!isnan(proximity.filteredDistanceCm)) {
        const int fillWidth = distanceToBarX(proximity.filteredDistanceCm, kBarX, kBarW) - kBarX - 1;
        if (fillWidth > 0) {
            u8g2.drawBox(kBarX + 1, kBarY + 1, fillWidth, kBarH - 2);
        }

        const int warnX = distanceToBarX(kProximityWarnDistanceCm, kBarX, kBarW);
        const int tripX = distanceToBarX(kProximityTripDistanceCm, kBarX, kBarW);

        u8g2.drawVLine(warnX, kBarY - 2, 2);
        u8g2.drawVLine(tripX, kBarY - 2, 2);
    }

    if (!isnan(liveDistance)) {
        const int dotX = distanceToBarX(liveDistance, kBarX, kBarW);
        u8g2.setDrawColor(0);
        u8g2.drawDisc(dotX, kBarY + (kBarH / 2), 2);
        u8g2.setDrawColor(1);
        u8g2.drawCircle(dotX, kBarY + (kBarH / 2), 2);
    }

    u8g2.sendBuffer();
}

void drawDisplay() {
    drawProximityDisplay();
}

void handleButton() {
    const bool reading = digitalRead(BOOT_BTN);
    const uint32_t now = millis();

    if (reading != buttonReading) {
        buttonReading = reading;
        buttonChangedAt = now;
    }

    if (now - buttonChangedAt < kButtonDebounceMs) {
        return;
    }

    if (buttonReading == LOW && !buttonHandled) {
        buttonHandled = true;
        if (state.mode == RunMode::Manual) {
            setSceneMode(0);
        } else if (state.mode == RunMode::Scene && state.selectedScene + 1 < kSceneCount) {
            setSceneMode(state.selectedScene + 1);
        } else if (state.mode == RunMode::Scene) {
            setAutoplayMode();
        } else {
            setManualMode();
        }
    } else if (buttonReading == HIGH) {
        buttonHandled = false;
    }
}

void startAccessPoint() {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(kAccessPointSsid, kAccessPointPassword);
}

}  // namespace

void setup() {
    Serial.begin(115200);
    delay(300);

    pinMode(LED_PIN, OUTPUT);
    pinMode(BOOT_BTN, INPUT_PULLUP);
    pinMode(US_TRIG_PIN, OUTPUT);
    pinMode(US_ECHO_PIN, INPUT);
    pinMode(IR_TX_PIN, OUTPUT);
    digitalWrite(LED_PIN, LOW);
    digitalWrite(US_TRIG_PIN, LOW);
    setIrIdleLevel();

    Wire.begin(OLED_SDA, OLED_SCL);
    u8g2.setI2CAddress(OLED_ADDR << 1);
    u8g2.begin();
    u8g2.setContrast(255);

    setSceneMode(0);
    state.blackout = true;

    startAccessPoint();
    configureWebServer();
    dmxReady = dmx.begin(DMX_TX_PIN, DMX_DIR_PIN);
    resetProximitySamples();

    Serial.println();
    Serial.println("ESP32-C3 Laser Show controller");
    Serial.printf("AP SSID: %s\n", kAccessPointSsid);
    Serial.printf("AP PASS: %s\n", kAccessPointPassword);
    Serial.printf("Open: http://%s/\n", WiFi.softAPIP().toString().c_str());
}

void loop() {
    server.handleClient();
    handleButton();
    updateSceneEngine();
    updateProximity();
    updateStripColor();
    updateStatusLed();

    const uint32_t now = millis();
    if (now - lastDmxFrameAt >= kDmxFrameIntervalMs) {
        lastDmxFrameAt = now;
        applyDmxState();
    }

    if (now - lastDisplayAt >= kDisplayRefreshMs) {
        lastDisplayAt = now;
        drawDisplay();
    }
}
