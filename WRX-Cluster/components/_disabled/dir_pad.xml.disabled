<component>
    <api>
        <prop name="letter" type="string" default="L"/>
    </api>

    <view extends="lv_obj" width="86" height="86">
        <style name="st_circle_dk"/>
        <lv_label text="^"  align="top_mid"    y="6"
                  style_text_color="0xFD7E2A"/>
        <lv_label text="v"  align="bottom_mid" y="-6"
                  style_text_color="0xFD7E2A"/>
        <lv_label text="&lt;" align="left_mid"  x="6"
                  style_text_color="0xFD7E2A"/>
        <lv_label text="&gt;" align="right_mid" x="-6"
                  style_text_color="0xFD7E2A"/>
        <lv_label text="$letter" align="center"
                  style_text_color="0xFD7E2A"/>
    </view>
</component>
