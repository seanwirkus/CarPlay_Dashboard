<component>
    <view extends="lv_obj" width="302" height="245">
        <style name="st_card"/>

        <lv_label text="My Calendar" align="top_left" x="0" y="0"
                  style_text_color="0xFFFFFF"/>

        <lv_label text="..." align="top_right" x="0" y="0"
                  style_text_color="0xFFFFFF"/>

        <lv_label text="5 Aug - 2022" align="top_left" x="0" y="40"
                  style_text_color="0x87888C"/>

        <lv_obj width="262" height="40" align="top_left" x="0" y="74"
                style_pad_all="0" style_border_width="0"
                style_bg_color="0x2B2A2A" style_bg_opa="160"
                style_radius="8">
            <lv_label text="Mon  Tue  Wed  Thu  Fri  Sat  Sun" align="center"
                      style_text_color="0xFFFFFF"/>
        </lv_obj>

        <lv_label text="5:00" align="bottom_left" x="0" y="-58"
                  style_text_color="0x87888C"/>

        <lv_label text="6:00" align="bottom_left" x="0" y="-12"
                  style_text_color="0x87888C"/>

        <lv_obj width="214" height="68" align="bottom_right" x="0" y="-46"
                style_pad_left="14" style_pad_top="8"
                style_border_width="0"
                style_bg_color="0x484848" style_bg_opa="255"
                style_radius="7">
            <lv_label text="Meeting with clients" align="top_left" x="0" y="0"
                      style_text_color="0xFFFFFF"/>
            <lv_label text="5:00 - 6:20" align="top_left" x="0" y="24"
                      style_text_color="0x87888C"/>
        </lv_obj>
    </view>
</component>
