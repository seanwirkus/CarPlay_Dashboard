<component>
    <view extends="lv_obj" width="480" height="120">
        <style name="st_card"/>

        <lv_obj width="88" height="88" align="left_mid" x="0" y="0"
                style_pad_all="0" style_border_width="0"
                style_bg_color="0x2A2F38" style_bg_opa="255"
                style_radius="16">
            <lv_label text="&#xF001;" align="center"
                      style_text_color="0xFD7E2A"
                      style_text_font="lv_montserrat_32"/>
        </lv_obj>

        <lv_label bind_text="sp_song" align="top_left" x="104" y="6"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_18"/>

        <lv_label bind_text="sp_artist" align="top_left" x="104" y="32"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_14"/>

        <lv_label text="0:09" align="bottom_left" x="104" y="-4"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_12"/>
        <lv_label text="2:20" align="bottom_right" x="-12" y="-4"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_12"/>
        <lv_slider width="320" height="3" align="bottom_left" x="138" y="-22"
                   min_value="0" max_value="140" value="9"/>

        <!-- transport buttons -->
        <lv_label text="&#xF048;" align="top_right" x="-92" y="14"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_20"/>
        <lv_obj width="36" height="36" align="top_right" x="-52" y="6">
            <style name="st_accent"/>
            <lv_label text="&#xF04C;" align="center"
                      style_text_color="0xFFFFFF"
                      style_text_font="lv_montserrat_18"/>
        </lv_obj>
        <lv_label text="&#xF051;" align="top_right" x="-12" y="14"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_20"/>
    </view>
</component>
