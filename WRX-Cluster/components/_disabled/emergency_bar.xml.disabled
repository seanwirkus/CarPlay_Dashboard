<component>
    <view extends="lv_obj" width="540" height="79">
        <style name="st_card"/>

        <lv_obj width="53" height="51" align="left_mid" x="0" y="0"
                style_pad_all="0" style_border_width="0"
                style_bg_color="0x2B2A2A" style_bg_opa="255"
                style_radius="4">
            <lv_label text="!" align="center"
                      style_text_color="0xFD7E2A"/>
        </lv_obj>

        <lv_label text="Emergency" align="top_left" x="72" y="2"
                  style_text_color="0xFFFFFF"/>

        <lv_label text="Switch On only in emergency case"
                  align="top_left" x="72" y="26"
                  style_text_color="0x87888C"/>

        <lv_switch align="right_mid" x="-10" y="0"/>
    </view>
</component>
