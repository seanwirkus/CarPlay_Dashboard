<component>
    <view extends="lv_obj" width="944" height="40"
          style_pad_all="0" style_border_width="0" style_bg_opa="0">

        <lv_label text="Dashboard" align="left_mid" x="0" y="0"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_22"/>

        <!-- search pill -->
        <lv_obj width="360" height="36" align="center" x="0" y="0">
            <style name="st_pill"/>
            <lv_label text="&#xF002;" align="left_mid" x="4" y="0"
                      style_text_color="0x8A8F99"
                      style_text_font="lv_montserrat_14"/>
            <lv_label text="Search" align="left_mid" x="28" y="0"
                      style_text_color="0x8A8F99"
                      style_text_font="lv_montserrat_14"/>
        </lv_obj>

        <!-- weather chip -->
        <lv_label text="25 C - Rainy" align="right_mid" x="-160" y="0"
                  style_text_color="0xB8BCC4"
                  style_text_font="lv_montserrat_14"/>

        <!-- bell -->
        <lv_obj width="36" height="36" align="right_mid" x="-72" y="0">
            <style name="st_circle_chip"/>
            <lv_label text="&#xF0F3;" align="center"
                      style_text_color="0xF2F4F8"
                      style_text_font="lv_montserrat_16"/>
            <lv_obj width="8" height="8" align="top_right" x="-2" y="2"
                    style_pad_all="0" style_border_width="0"
                    style_bg_color="0xFF3B30" style_bg_opa="255"
                    style_radius="9999"/>
        </lv_obj>

        <!-- avatar -->
        <lv_obj width="40" height="40" align="right_mid" x="0" y="0">
            <style name="st_circle_chip"/>
            <lv_label text="SW" align="center"
                      style_text_color="0xF2F4F8"
                      style_text_font="lv_montserrat_14"/>
        </lv_obj>
    </view>
</component>
