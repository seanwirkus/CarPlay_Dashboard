<component>
    <api>
        <prop name="glyph"  type="string" default=""/>
        <prop name="active" type="bool"   default="false"/>
    </api>

    <view extends="lv_button" width="56" height="56">
        <style name="st_circle_dk"/>
        <lv_label text="$glyph" align="center"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_22"/>
    </view>
</component>
