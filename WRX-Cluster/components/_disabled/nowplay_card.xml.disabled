<component>
    <view extends="lv_obj" width="224" height="180">
        <style name="st_card"/>

        <!-- album art -->
        <lv_obj width="64" height="64" align="top_left" x="0" y="0"
                style_pad_all="0" style_border_width="0"
                style_bg_color="0x2A2F38" style_bg_opa="255"
                style_radius="14">
            <lv_label text="&#xF001;" align="center"
                      style_text_color="0xFD7E2A"
                      style_text_font="lv_montserrat_28"/>
        </lv_obj>

        <lv_label text="Now Playing" align="top_left" x="76" y="2"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_12"/>

        <lv_label bind_text="sp_song" align="top_left" x="76" y="20"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_14"
                  long_mode="scroll" width="116"/>

        <lv_label bind_text="sp_artist" align="top_left" x="76" y="42"
                  style_text_color="0xB8BCC4"
                  style_text_font="lv_montserrat_12"/>

        <!-- transport -->
        <lv_label text="&#xF048;" align="bottom_left" x="2" y="-8"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_22"/>
        <lv_obj width="48" height="48" align="bottom_mid" y="-4">
            <style name="st_accent"/>
            <lv_label text="&#xF04C;" align="center"
                      style_text_color="0xFFFFFF"
                      style_text_font="lv_montserrat_22"/>
        </lv_obj>
        <lv_label text="&#xF051;" align="bottom_right" x="-2" y="-8"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_22"/>
    </view>
</component>
