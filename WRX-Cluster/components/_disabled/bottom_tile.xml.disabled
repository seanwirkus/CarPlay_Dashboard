<component>
    <api>
        <prop name="title"  type="string" default=""/>
        <prop name="glyph"  type="string" default=""/>
        <prop name="value"  type="string" default=""/>
        <prop name="tile_w" type="int"    default="108"/>
    </api>

    <view extends="lv_obj" width="$tile_w" height="92">
        <style name="st_tile"/>
        <lv_label text="$glyph" align="top_left" x="2" y="2"
                  style_text_color="0xFD7E2A"
                  style_text_font="lv_montserrat_22"/>
        <lv_label text="$value" align="top_right" x="-2" y="2"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_18"/>
        <lv_label text="$title" align="bottom_left" x="2" y="-2"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_14"/>
    </view>
</component>
