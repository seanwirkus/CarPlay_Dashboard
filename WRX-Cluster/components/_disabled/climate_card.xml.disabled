<component>
    <view extends="lv_obj" width="240" height="180">
        <style name="st_card"/>

        <lv_label text="Climate" align="top_left" x="0" y="0"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_18"/>

        <lv_label text="&#xF2C9;" align="top_right" x="0" y="0"
                  style_text_color="0xFD7E2A"
                  style_text_font="lv_montserrat_22"/>

        <lv_label align="left_mid" x="0" y="0"
                  bind_text="sp_climate"
                  style_text_color="0xF2F4F8"
                  style_text_font="lv_montserrat_48"/>

        <lv_label text="C" align="left_mid" x="80" y="-10"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_22"/>

        <lv_label text="INTERIOR 24 / EXT 25" align="bottom_left" x="0" y="-26"
                  style_text_color="0x8A8F99"
                  style_text_font="lv_montserrat_12"/>

        <lv_slider width="208" height="6" align="bottom_mid" y="-4"
                   min_value="10" max_value="40" value="23"/>
    </view>
</component>
